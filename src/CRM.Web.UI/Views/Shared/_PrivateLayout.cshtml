@{
    Layout = null;
}

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width,initial-scale=1" />
        <title>Piistech Academy · Admin</title>
        <link href="~/css/layout/site.css" rel="stylesheet" />
    </head>
    <body>
        <div class="backdrop" onclick="toggleMenu()"></div>
        <aside>
            <div class="brand">
                <span class="logo">p</span>
                <div>piistech<small>ACADEMY</small></div>
            </div>
            <div class="institution">
                <span class="avatar">PA</span>
                <div>
                    <b style="font-size: 12px" id="institutionLabel">Piistech Academy</b
                    ><small>Institution workspace</small>
                </div>
            </div>
            <div class="navlabel">WORKSPACE</div>
            <nav id="nav"></nav>
            <div class="upgrade">
                <b>Professional plan <span style="color: #635bdf">✦</span></b>
                <p>Demo workspace · 6 of 20 courses</p>
                <div class="bar"><i style="width: 30%"></i></div>
                <button class="text-btn" style="padding: 12px 0 0" onclick="go('Settings')">
                    Manage institution →
                </button>
            </div>
        </aside>
        <main>
            <header>
                <button class="mobile-menu" aria-label="Open navigation" onclick="toggleMenu()">
                    ☰
                </button>
                <div class="crumb">
                    Workspace <span style="margin: 0 12px; color: #c1c6d0">/</span
                    ><span id="crumb">Overview</span>
                </div>
                <div class="header-right">
                    <span style="font-size: 11px; color: #8a93a4">● Demo mode</span
                    ><button
                        aria-label="Notifications"
                        onclick="showNotifications()"
                        id="bell"
                    ></button
                    ><span style="height: 28px; border-left: 1px solid var(--line)"></span>
                    <div class="person">
                        <span
                            class="avatar"
                            style="background: #f5e9db; color: #996e45; border-radius: 50%"
                            >PK</span
                        >
                        <div><b>Parves Kawser</b><small>Institution Admin</small></div>
                    </div>
                </div>
            </header>
            <div class="content">
                
                @RenderBody()

               

                <footer>
                    <span>© 2026 Piistech Academy. All rights reserved.</span
                    ><span>HTML prototype · Sample data · Asia/Dhaka</span>
                </footer>
            </div>
        </main>
        <dialog id="modal">
            <form id="form">
                <div class="modal-head">
                    <h2 id="modalTitle"></h2>
                    <button type="button" aria-label="Close dialog" onclick="closeModal()">
                        ✕
                    </button>
                </div>
                <div class="form-body" id="fields"></div>
                <div class="actions">
                    <button class="btn" type="button" onclick="closeModal()">Cancel</button
                    ><button class="btn primary" type="submit">Save changes</button>
                </div>
            </form>
        </dialog>
        <div class="notice" role="status" id="toast"></div>
        <script>
            const paths = {
                Overview: "M3 3h7v7H3z M14 3h7v7h-7z M3 14h7v7H3z M14 14h7v7h-7z",
                Courses: "M4 4h6l2 2 2-2h6v16h-6l-2 2-2-2H4z M12 6v16",
                Students:
                    "M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2 M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8 M18 8a3 3 0 0 1 0 6 M22 21v-2a4 4 0 0 0-3-4",
                Instructors: "M12 3 2 8l10 5 10-5-10-5 M6 10v7c4 3 8 3 12 0v-7 M22 8v8",
                Batches: "M4 5h16v16H4z M8 2v6 M16 2v6 M4 11h16",
                Payments: "M3 5h18v14H3z M3 10h18 M7 15h4",
                Attendance: "M5 3h14v18H5z M9 8l2 2 4-4 M9 15h6",
                Quizzes: "M5 3h14v18H5z M9 7h6 M9 12h6 M9 17h3",
                Reports: "M4 20V10 M10 20V4 M16 20v-8 M22 20H2",
                Settings:
                    "M12 8a4 4 0 1 0 0 8 4 4 0 0 0 0-8 M9 3h6l1 3 3 1 2 5-2 5-3 1-1 3H9l-1-3-3-1-2-5 2-5 3-1z",
                Bell: "M18 8a6 6 0 0 0-12 0v6l-2 3h16l-2-3V8 M10 21h4",
            };
            const icon = (n) =>
                `<span class="icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="${paths[n] || paths.Courses}"/></svg></span>`;
            const seed = {
                Courses: [
                    {
                        id: 1,

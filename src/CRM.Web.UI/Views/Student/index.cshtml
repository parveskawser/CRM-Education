@using CRM.Entities

@model List<Student>

@{
    Layout = "~/Views/Shared/_PrivateLayout.cshtml";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">Our Students</h2>
            <p class="text-muted mb-0">Manage registered students</p>
        </div>

        <span class="badge bg-primary fs-6">
            Total Students: @Model.Count
        </span>
    </div>

    <div class="row g-4">

        @foreach (var student in Model)
        {
            <div class="col-md-6 col-lg-4">

                <div class="card h-100 shadow-sm border-0">

                    <div class="card-body d-flex flex-column">

                        <div class="d-flex justify-content-between align-items-start mb-2">

                            <span class="badge bg-info text-dark">
                                @student.Gender
                            </span>

                            @if (student.Status == "Active")
                            {
                                <span class="badge bg-success">
                                    Active
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    @student.Status
                                </span>
                            }

                        </div>

                        <h5 class="card-title">
                            @student.FullName
                        </h5>

                        <p class="card-text text-muted mb-3">
                            @student.Email
                        </p>

                        <div class="small text-muted mb-3">

                            <div>
                                Phone: @student.Phone
                            </div>

                            <div>
                                Address: @student.Address
                            </div>

                            <div>
                                Enrollment:
                                @student.EnrollmentDate.ToString("dd MMM yyyy")
                            </div>

                        </div>

                        <div class="mt-auto">

                            <a asp-controller="Student" asp-action="Detail" asp-route-id="@student.Id"
                               class="btn btn-primary btn-sm">
                                View Student
                            </a>

                        </div>

                    </div>

                </div>

            </div>
        }

    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info text-center">
            No students are available right now.
        </div>
    }

</div>

<h1>Page no: @ViewBag.pageno</h1>
@using CRM.Entities

@model List<Course>

@{
    Layout = "_PrivateLayout";
}

@* @foreach(var item in Model)
{
    <h4>@item.Title</h4>
} *@


<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">Our Courses</h2>
            <p class="text-muted mb-0">Explore available learning courses</p>
        </div>

        <span class="badge bg-primary fs-6">
            Total Courses: @Model.Count
        </span>
    </div>

    <div class="row g-4">
        @foreach (var course in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm border-0">
                     

                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <span class="badge bg-info text-dark">@course.Level</span>

                            @if (course.IsFeatured)
                            {
                                <span class="badge bg-warning text-dark">Featured</span>
                            }
                        </div>

                        <h5 class="card-title">@course.Title</h5>

                        <p class="card-text text-muted">
                            @course.ShortDescription
                        </p>

                        <div class="small text-muted mb-3">
                            <div>Language: @course.Language</div>
                            <div>Lessons: @course.TotalLessons</div>
                            <div>Duration: @course.DurationInMinutes minutes</div>
                        </div>

                        <div class="mt-auto d-flex justify-content-between align-items-center">
                            <div>
                                @if (course.DiscountPrice.HasValue)
                                {
                                    <span class="fw-bold text-success">
                                        ৳@course.DiscountPrice.Value.ToString("N0")
                                    </span>
                                    <small class="text-muted text-decoration-line-through ms-1">
                                        ৳@course.Price.ToString("N0")
                                    </small>
                                }
                                else
                                {
                                    <span class="fw-bold text-success">
                                        ৳@course.Price.ToString("N0")
                                    </span>
                                }
                            </div>

                            @if (course.IsPublished)
                            {
                                <a asp-controller="Courses"
                                   asp-action="Detail"
                                   asp-route-id="@course.Id"
                                   class="btn btn-primary btn-sm">
                                    View Course
                                </a>
                            }
                            else
                            {
                                <button class="btn btn-secondary btn-sm" disabled>
                                    Coming Soon
                                </button>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info text-center">
            No courses are available right now.
        </div>
    }
</div>


<h1>Page no: @ViewBag.pageno </h1>
@{
    Layout = null;
}


<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign In</title>
    
    <link href="~/css/account/login.css" rel="stylesheet" />
</head>
<body>
    <main class="login-card">
        <div class="brand">L</div>
        <h1>
            Welcome back
        </h1>
        <p class="subtitle">Sign in to access your account and continue where you left off.</p>

        <form action="#" method="post">
            <label for="email">Email address</label>
            <input id="email" name="email" type="email" placeholder="you@example.com" autocomplete="email" required />

            <label for="password">Password</label>
            <input id="password" name="password" type="password" placeholder="Enter your password" autocomplete="current-password" required />

            <div class="options">
                <label class="remember"><input type="checkbox" name="remember" /> Remember me</label>
                <a href="#">Forgot password?</a>
            </div>

            <button type="submit">Sign In</button>
        </form>

        <p class="signup">Don’t have an account? <a href="#">Create one</a></p>
    </main>
</body>
</html>


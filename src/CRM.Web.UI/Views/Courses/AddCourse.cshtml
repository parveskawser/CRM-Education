@using CRM.Entities
 
@{
    Layout = "_PrivateLayout";
}

@model Course

@{
    ViewData["Title"] = "Create Course";
}

<h2>Create Course</h2>

<form asp-action="AddCourse" method="post">

    <div>
        <label asp-for="Title"></label>
        <input asp-for="Title" />
    </div>

    <br />

    <div>
        <label asp-for="ShortDescription"></label>
        <textarea asp-for="ShortDescription"></textarea>
    </div>

    <br />

    <div>
        <label asp-for="Description"></label>
        <textarea asp-for="Description"></textarea>
    </div>

    <br />

    <div>
        <label asp-for="ThumbnailUrl"></label>
        <input asp-for="ThumbnailUrl" />
    </div>

    <br />

    <div>
        <label asp-for="Price"></label>
        <input asp-for="Price" type="number" step="0.01" />
    </div>

    <br />

    <div>
        <label asp-for="DiscountPrice"></label>
        <input asp-for="DiscountPrice" type="number" step="0.01" />
    </div>

    <br />

    <div>
        <label asp-for="InstructorId"></label>
        <input asp-for="InstructorId" type="number" />
    </div>

    <br />

    <div>
        <label asp-for="CategoryId"></label>
        <input asp-for="CategoryId" type="number" />
    </div>

    <br />

    <div>
        <label asp-for="Level"></label>

        <select asp-for="Level">
            <option value="Beginner">Beginner</option>
            <option value="Intermediate">Intermediate</option>
            <option value="Advanced">Advanced</option>
        </select>
    </div>

    <br />

    <div>
        <label asp-for="Language"></label>

        <select asp-for="Language">
            <option value="Bangla">Bangla</option>
            <option value="English">English</option>
        </select>
    </div>

    <br />

    <div>
        <label asp-for="TotalLessons"></label>
        <input asp-for="TotalLessons" type="number" />
    </div>

    <br />

    <div>
        <label asp-for="DurationInMinutes"></label>
        <input asp-for="DurationInMinutes" type="number" />
    </div>

    <br />

    <div>
        <input asp-for="IsPublished" />
        <label asp-for="IsPublished">Publish Course</label>
    </div>

    <br />

    <div>
        <input asp-for="IsFeatured" />
        <label asp-for="IsFeatured">Featured Course</label>
    </div>

    <br />

    <button type="submit">Save Course</button>

</form>
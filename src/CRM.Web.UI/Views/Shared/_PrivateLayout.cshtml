                    },
                    {
                        id: 3,
                        name: "Mehedi Hasan",
                        course: "UI/UX Design Essentials",
                        date: "2026-10-05",
                        status: "Late",
                    },
                ],
                Quizzes: [
                    {
                        id: 1,
                        name: "C# Fundamentals",
                        course: "Full Stack ASP.NET Core",
                        questions: 20,
                        duration: 30,
                        status: "Published",
                    },
                    {
                        id: 2,
                        name: "Design Principles",
                        course: "UI/UX Design Essentials",
                        questions: 15,
                        duration: 20,
                        status: "Draft",
                    },
                    {
                        id: 3,
                        name: "Marketing Strategy",
                        course: "Digital Marketing Masterclass",
                        questions: 25,
                        duration: 40,
                        status: "Scheduled",
                    },
                ],
                settings: {
                    name: "Piistech Academy",
                    email: "hello@piistech.com",
                    timezone: "Asia/Dhaka",
                    language: "English",
                    currency: "BDT",
                },
            };
            let db;
            try {
                db =
                    JSON.parse(localStorage.getItem("piistech-lms-demo-v1")) ||
                    structuredClone(seed);
            } catch {
                db = structuredClone(seed);
            }
            let page = "Overview",
                query = "",
                filter = "All",
                editing = null;
            const esc = (s) =>
                String(s ?? "").replace(
                    /[&<>"']/g,
                    (c) =>
                        ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[
                            c
                        ],
                );
            const money = (n) => "৳" + Number(n).toLocaleString("en-IN");
            const badge = (s) => `<span class="badge ${esc(s)}">${esc(s)}</span>`;
            let toastTimer;
            function notify(msg) {
                document.getElementById("toast").textContent = msg;
                clearTimeout(toastTimer);
                toastTimer = setTimeout(
                    () => (document.getElementById("toast").textContent = ""),
                    4000,
                );
            }
            function persist() {
                try {
                    localStorage.setItem("piistech-lms-demo-v1", JSON.stringify(db));
                } catch {
                    notify("Browser storage is unavailable. Changes last until this page closes.");
                }
            }
            function toggleMenu() {
                document.body.classList.toggle("menu");
            }
            function go(p) {
                page = p;
                query = "";
                filter = "All";
                document.body.classList.remove("menu");
                render();
            }
            function closeModal() {
                document.getElementById("modal").close();
            }
            function showNotifications() {
                document.getElementById("modalTitle").textContent = "Notifications";
                document.getElementById("fields").innerHTML =
                    "<p>2 courses are waiting for publication.</p><p>1 bank transfer needs verification.</p><p>Your next live class begins at 9:00 PM.</p><small>Sample notifications for this prototype.</small>";
                document.querySelector("#modal .actions").style.display = "none";
                document.getElementById("modal").showModal();
            }
            function heading(title, sub, actions = "") {
                return `<div class="heading"><div><h1>${title}</h1><p>${sub}</p></div><div class="actions">${actions}</div></div>`;
            }
            function stat(title, value, foot, type) {
                return `<div class="stat"><div class="stat-top">${title}<span class="stat-icon">${icon(type)}</span></div><strong>${value}</strong><small>${foot}</small></div>`;
            }
            function chart() {
                return `<div class="chart"><div class="legend" style="justify-content:flex-end;margin-bottom:12px"><span><i class="dot"></i>Collections</span><span><i class="dot" style="background:#c9c5f4"></i>Previous period</span></div><svg viewBox="0 0 650 205" role="img" aria-label="Illustrative collections chart from May to October, rising from 85 to 240 thousand taka"><defs><linearGradient id="fade" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#8175e6" stop-opacity=".18"/><stop offset="1" stop-color="#8175e6" stop-opacity="0"/></linearGradient></defs><g stroke="#edf0f6" stroke-dasharray="4 5"><path d="M50 20H630M50 65H630M50 110H630M50 155H630"/></g><g fill="#98a1b1" font-size="10"><text x="0" y="24">৳300k</text><text x="0" y="69">৳200k</text><text x="0" y="114">৳100k</text><text x="22" y="159">৳0</text><text x="48" y="192">May</text><text x="159" y="192">Jun</text><text x="274" y="192">Jul</text><text x="387" y="192">Aug</text><text x="500" y="192">Sep</text><text x="609" y="192">Oct</text></g><path d="M55 119C105 118 120 74 170 87S240 122 285 90 355 85 400 67 470 104 515 58 575 58 625 42V155H55Z" fill="url(#fade)"/><path d="M55 139C110 121 121 133 170 120S240 133 285 113 354 116 400 100 470 124 515 93 580 113 625 88" stroke="#c9c5f4" fill="none" stroke-width="2" stroke-dasharray="5 5"/><path d="M55 119C105 118 120 74 170 87S240 122 285 90 355 85 400 67 470 104 515 58 575 58 625 42" fill="none" stroke="#7569db" stroke-width="3"/><circle cx="625" cy="42" r="4" fill="#7569db" stroke="white" stroke-width="2"/></svg></div>`;
            }
            function overview() {
                let paid = db.Payments.filter((x) => x.status === "Paid").reduce(
                    (n, x) => n + x.amount,
                    0,
                );
                return (
                    heading(
                        "Your academy, at a glance",
                        "Welcome back, Parves. Here’s what’s happening today.",
                        `<span class="btn">▦ &nbsp; October 2026</span><button class="btn primary" onclick="openEditor('Courses')">＋ Create course</button>`,
                    ) +
                    `<div class="stats">${stat(
                        "Total enrollments",
                        db.Courses.reduce((n, x) => n + Number(x.students), 0),
                        '<span class="up">↗ 12.8%</span> vs. last month · sample',
                        "Students",
                    )}${stat("Published courses", db.Courses.filter((x) => x.status === "Published").length, db.Courses.filter((x) => x.status === "Draft").length + " courses in draft", "Courses")}${stat("Verified collections", money(paid), "From the demo payment register", "Payments")}${stat("Active instructors", db.Instructors.filter((x) => x.status === "Active").length, "Across all course categories", "Instructors")}</div><div class="grid"><section class="card"><div class="card-head"><div><h2>Collections overview</h2><p>Illustrative six-month performance</p></div><button class="text-btn" onclick="go('Reports')">View reports ↗</button></div>${chart()}</section><section class="card"><div class="card-head"><div><h2>Learning activity</h2><p>Illustrative cohort distribution</p></div></div><div class="donut-area"><div class="donut"><div><strong>86%</strong><small>Engagement rate</small></div></div><div><div class="key"><i class="dot"></i>In progress<b>62%</b></div><div class="key"><i class="dot" style="background:#aea9ef"></i>Completed<b>24%</b></div><div class="key"><i class="dot" style="background:#e8e6fb"></i>Not started<b>14%</b></div></div></div></section></div><div class="grid"><section class="card"><div class="card-head"><div><h2>Popular courses</h2><p>Your learning catalog at a glance</p></div><button class="text-btn" onclick="go('Courses')">View all →</button></div><div class="table-wrap"><table><thead><tr><th>Course name</th><th>Students</th><th>Status</th><th></th></tr></thead><tbody>${db.Courses.slice(
                        0,
                        4,
                    )
                        .map(
                            (c) =>
                                `<tr><td><div class="course-name"><span class="course-tile">${esc(c.category.slice(0, 2).toUpperCase())}</span><div><b>${esc(c.name)}</b><small>${esc(c.instructor)}</small></div></div></td><td>${c.students}</td><td>${badge(c.status)}</td><td><button aria-label="Edit ${esc(c.name)}" onclick="openEditor('Courses',${c.id})">↗</button></td></tr>`,
                        )
                        .join(
                            "",
                        )}</tbody></table></div></section><section class="card"><div class="card-head"><div><h2>Upcoming live classes</h2><p>All times in Asia/Dhaka</p></div><button class="text-btn" onclick="go('Batches')">View all →</button></div>${[
                        [
                            "05",
                            "OCT",
                            "ASP.NET Core: Getting started",
                            "Parves Kawser",
                            "9:00 – 11:00 PM",
                        ],
                        ["06", "OCT", "Wireframing & user flows", "Nusrat Jahan", "7:00 – 9:00 PM"],
                        ["07", "OCT", "Building REST APIs", "Parves Kawser", "9:00 – 11:00 PM"],
                    ]
                        .map(
                            (s) =>
                                `<div class="session"><div class="session-date"><small>${s[1]}</small><b>${s[0]}</b></div><div><strong>${s[2]}</strong><p>${s[3]}</p><div class="session-bottom"><span>◷ ${s[4]}</span><span style="color:#635bdf">• Live class</span></div></div></div>`,
                        )
                        .join("")}</section></div>`
                );
            }
            const schemas = {
                Courses: [
                    ["name", "Course title"],
                    ["category", "Category"],
                    ["instructor", "Instructor"],
                    ["students", "Enrolled students", "number"],
                    ["price", "Price (BDT)", "number"],
                    ["status", "Status", ["Draft", "Published", "Archived"]],
                ],
                Students: [
                    ["name", "Student name"],
                    ["email", "Email", "email"],
                    ["course", "Course"],
                    ["progress", "Progress (%)", "number"],
                    ["status", "Status", ["Pending", "Active", "Completed", "Expired"]],
                ],
                Instructors: [
                    ["name", "Instructor name"],
                    ["email", "Email", "email"],
                    ["expertise", "Expertise"],
                    ["status", "Status", ["Pending", "Active", "Inactive"]],
                ],
                Batches: [
                    ["name", "Batch name"],
                    ["course", "Course"],
                    ["schedule", "Schedule"],
                    ["capacity", "Capacity", "number"],
                    ["status", "Status", ["Scheduled", "Active", "Completed"]],
                ],
                Payments: [
                    ["name", "Student name"],
                    ["course", "Course"],
                    ["amount", "Amount (BDT)", "number"],
                    ["method", "Payment method", ["bKash", "Nagad", "Card", "Bank transfer"]],
                    ["status", "Status", ["Pending", "Paid", "Overdue", "Refunded"]],
                ],
                Attendance: [
                    ["name", "Student name"],
                    ["course", "Course"],
                    ["date", "Class date", "date"],
                    ["status", "Attendance", ["Present", "Absent", "Late", "Excused"]],
                ],
                Quizzes: [
                    ["name", "Quiz title"],
                    ["course", "Course"],
                    ["questions", "Questions", "number"],
                    ["duration", "Duration (minutes)", "number"],
                    ["status", "Status", ["Draft", "Scheduled", "Published", "Closed"]],
                ],
            };
            const singular = {
                Courses: "course",
                Students: "student",
                Instructors: "instructor",
                Batches: "batch",
                Payments: "payment",
                Attendance: "attendance",
                Quizzes: "quiz",
            };
            function tablePage() {
                return (
                    heading(
                        page,
                        `Manage your institution’s ${page.toLowerCase()} in one place.`,
                        `<button class="btn" onclick="exportCSV('${page}')">↓ Export CSV</button><button class="btn primary" onclick="openEditor('${page}')">＋ Add ${singular[page]}</button>`,
                    ) +
                    (page === "Payments"
                        ? '<div class="hint">Prototype only. Payment status edits here do not verify or process real transactions.</div>'
                        : "") +
                    `<section class="card"><div class="toolbar"><input aria-label="Search ${page}" id="search" placeholder="Search ${page.toLowerCase()}…" oninput="query=this.value;updateRows()"><select aria-label="Filter by status" onchange="filter=this.value;updateRows()"><option>All</option>${schemas[
                        page
                    ]
                        .find((x) => x[0] === "status")[2]
                        .map((s) => `<option>${s}</option>`)
                        .join(
                            "",
                        )}</select></div><div class="table-wrap"><table><thead><tr>${schemas[page].map((x) => `<th>${x[1]}</th>`).join("")}<th>Action</th></tr></thead><tbody id="rows"></tbody></table></div><div style="padding:14px 22px;font-size:11px;color:var(--muted)" id="count"></div></section>`
                );
            }
            function filtered(p = page) {
                return db[p].filter(
                    (x) =>
                        (filter === "All" || x.status === filter) &&
                        Object.values(x).join(" ").toLowerCase().includes(query.toLowerCase()),
                );
            }
            function updateRows() {
                let rows = filtered();
                document.getElementById("rows").innerHTML = rows.length
                    ? rows
                          .map(
                              (r) =>
                                  `<tr>${schemas[page].map(([k]) => `<td>${k === "status" ? badge(r[k]) : k === "price" || k === "amount" ? money(r[k]) : k === "progress" ? `<div style="display:flex;gap:10px;align-items:center"><div class="bar" style="width:70px"><i style="width:${Number(r[k])}%"></i></div>${r[k]}%</div>` : k === "name" ? `<b>${esc(r[k])}</b>` : esc(r[k])}</td>`).join("")}<td><button class="text-btn" onclick="openEditor('${page}',${r.id})">Edit</button></td></tr>`,
                          )
                          .join("")
                    : `<tr><td colspan="${schemas[page].length + 1}" class="empty">No matching records. Try another search or add a new record.</td></tr>`;
                document.getElementById("count").textContent =
                    `Showing ${rows.length} of ${db[page].length} records`;
            }
            function openEditor(type, id) {
                editing = { type, id };
                let row = db[type].find((x) => x.id === id) || {};
                document.querySelector("#modal .actions").style.display = "flex";
                document.getElementById("modalTitle").textContent =
                    (id ? "Edit " : "Add ") + singular[type];
                document.getElementById("fields").innerHTML = schemas[type]
                    .map(
                        ([k, label, kind]) =>
                            `<label>${label}${Array.isArray(kind) ? `<select name="${k}">${kind.map((s) => `<option ${row[k] === s ? "selected" : ""}>${s}</option>`).join("")}</select>` : `<input required name="${k}" type="${kind || "text"}" ${kind === "number" ? `min="0" step="${k === "amount" || k === "price" ? "0.01" : "1"}" ${k === "progress" ? 'max="100"' : ""}` : ""} value="${esc(row[k] ?? "")}">`}</label>`,
                    )
                    .join("");
                document.getElementById("modal").showModal();
            }
            document.getElementById("form").addEventListener("submit", (e) => {
                e.preventDefault();
                if (!editing) return;
                let { type, id } = editing;
                let values = Object.fromEntries(new FormData(e.target));
                for (let [k, , kind] of schemas[type])
                    if (kind === "number") values[k] = Number(values[k]);
                if (
                    values.email &&
                    db[type].some(
                        (r) => r.id !== id && r.email.toLowerCase() === values.email.toLowerCase(),
                    )
                )
                    return notify("This email already exists in this list.");
                if (id) {
                    Object.assign(
                        db[type].find((r) => r.id === id),
                        values,
                    );
                } else {
                    db[type].push({ ...values, id: Date.now() });
                }
                persist();
                closeModal();
                render();
                notify("Demo record saved successfully.");
                editing = null;
            });
            function exportCSV(p) {
                let rows = p === page && schemas[page] ? filtered(p) : db[p];
                let keys = schemas[p].map((x) => x[0]);
                let cell = (v) =>
                    '"' +
                    String(v ?? "")
                        .replace(/^[=+@@-]/, "'$&")
                        .replace(/"/g, '""') +
                    '"';
                let csv =
                    "\uFEFF" +
                    [
                        keys.map(cell).join(","),
                        ...rows.map((r) => keys.map((k) => cell(r[k])).join(",")),
                    ].join("\r\n");
                let url = URL.createObjectURL(new Blob([csv], { type: "text/csv;charset=utf-8" }));
                let a = document.createElement("a");
                a.href = url;
                a.download = "Piistech_" + p + ".csv";
                a.click();
                setTimeout(() => URL.revokeObjectURL(url), 1000);
                notify("CSV export downloaded.");
            }
            function reports() {
                return (
                    heading(
                        "Reports & insights",
                        "Download operational reports from the current demo records.",
                    ) +
                    `<div class="report-grid">${[
                        [
                            "Students",
                            "Enrollment report",
                            "Student enrollment status and learning progress.",
                        ],
                        [
                            "Payments",
                            "Collections report",
                            "Payment amounts, methods, and outstanding statuses.",
                        ],
                        [
                            "Attendance",
                            "Attendance report",
                            "Student attendance records by course and date.",
                        ],
                        [
                            "Courses",
                            "Course catalog report",
                            "Course pricing, instructors, and publication status.",
                        ],
                        [
                            "Instructors",
                            "Instructor directory",
                            "Instructor contact details and approval status.",
                        ],
                        [
                            "Quizzes",
                            "Assessment report",
                            "Quiz duration, question counts, and availability.",
                        ],
                    ]
                        .map(
                            ([p, t, d]) =>
                                `<section class="card report-box"><span class="stat-icon">${icon(p)}</span><h2 style="margin-top:18px">${t}</h2><p>${d}</p><button class="btn" onclick="exportCSV('${p}')">↓ Download CSV</button></section>`,
                        )
                        .join("")}</div>`
                );
            }
            function settings() {
                return (
                    heading(
                        "Institution settings",
                        "Manage the identity and preferences of your workspace.",
                    ) +
                    `<section class="card"><form class="settings" id="settingsForm"><h2>General information</h2><label>Institution name<input name="name" required value="${esc(db.settings.name)}"></label><label>Contact email<input name="email" type="email" required value="${esc(db.settings.email)}"></label><label>Timezone<input name="timezone" value="Asia/Dhaka" readonly></label><label>Interface language<input value="English (prototype)" readonly></label><label>Currency<input value="BDT · Bangladeshi Taka" readonly></label><div><button class="btn primary">Save settings</button></div><p style="font-size:11px">Changes are saved in this browser only. Authentication, payment gateways, and database services are not connected.</p><button class="text-btn" type="button" style="text-align:left;color:#bd6060" onclick="resetDemo()">Reset all demo data</button></form></section>`
                );
            }
            function resetDemo() {
                if (confirm("Reset all demo changes and restore the original sample data?")) {
                    db = structuredClone(seed);
                    persist();
                    render();
                    notify("Demo data restored.");
                }
            }
            function render() {
                document.getElementById("institutionLabel").textContent = db.settings.name;
                document.getElementById("crumb").textContent = page;
                document.getElementById("nav").innerHTML = Object.keys(paths)
                    .filter((n) => n !== "Bell")
                    .map(
                        (n) =>
                            `${n === "Reports" ? '<div class="navlabel" style="margin-top:20px">MANAGEMENT</div>' : ""}<button class="${n === page ? "active" : ""}" ${n === page ? 'aria-current="page"' : ""} onclick="go('${n}')">${icon(n)}${n}</button>`,
                    )
                    .join("");
                document.getElementById("bell").innerHTML = icon("Bell");
                document.getElementById("view").innerHTML =
                    page === "Overview"
                        ? overview()
                        : page === "Reports"
                          ? reports()
                          : page === "Settings"
                            ? settings()
                            : tablePage();
                if (schemas[page]) updateRows();
                if (page === "Settings")
                    document.getElementById("settingsForm").onsubmit = (e) => {
                        e.preventDefault();
                        Object.assign(db.settings, Object.fromEntries(new FormData(e.target)));
                        persist();
                        render();
                        notify("Institution settings saved.");
                    };
            }
            render();
        </script>
    </body>
</html>

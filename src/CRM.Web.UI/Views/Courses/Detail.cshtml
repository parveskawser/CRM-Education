@using CRM.Entities
@model Course

@{
    ViewData["Title"] = "Edit Course";
    Layout = "_PrivateLayout";
}

<div class="course-form-page">

    <div class="course-page-header">
        <div>
            <h2 class="course-page-title">Edit Course</h2>
            <p class="course-page-subtitle mb-0">
                Update course information for Piistech Academy
            </p>
        </div>

        <a asp-controller="Courses"
           asp-action="Index"
           class="course-btn-cancel">
            Back to Courses
        </a>
    </div>

    <form asp-controller="Course"
          asp-action="EditCourse"
          method="post"
          id="editCourseForm">

        @Html.AntiForgeryToken()

        <input asp-for="CourseId" type="hidden" />

        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3"></div>

        <div class="course-form-card">

            <h4 class="course-section-title">
                Basic Course Information
            </h4>

            <div class="row g-4">

                <div class="col-md-12">
                    <label asp-for="Title" class="form-label">
                        Course Title
                        <span class="course-required">*</span>
                    </label>

                    <input asp-for="Title"
                           class="form-control"
                           maxlength="200"
                           placeholder="Enter course title" />

                    <span asp-validation-for="Title"
                          class="text-danger small"></span>
                </div>

                <div class="col-md-12">
                    <label asp-for="Description" class="form-label">
                        Course Description
                    </label>

                    <textarea asp-for="Description"
                              class="form-control"
                              rows="5"
                              placeholder="Enter course description"></textarea>

                    <span asp-validation-for="Description"
                          class="text-danger small"></span>
                </div>

                <div class="col-md-12">
                    <label asp-for="InstructorId" class="form-label">
                        Select Instructor
                        <span class="course-required">*</span>
                    </label>

                    <select asp-for="InstructorId"
                            asp-items="ViewBag.Instructors"
                            class="form-select">
                        <option value="0">
                            -- Select Instructor --
                        </option>
                    </select>

                    <span asp-validation-for="InstructorId"
                          class="text-danger small"></span>
                </div>

            </div>
        </div>

        <div class="course-form-card">

            <h4 class="course-section-title">
                Pricing Information
            </h4>

            <div class="course-pricing-box">
                <div class="form-check form-switch">

                    <input asp-for="IsFree"
                           class="form-check-input"
                           type="checkbox"
                           id="isFreeSwitch" />

                    <label class="form-check-label fw-semibold"
                           for="isFreeSwitch">
                        Free Course
                    </label>
                </div>

                <p class="course-help-text mb-0">
                    Enable this option if the course is free.
                </p>
            </div>

            <div class="row" id="priceSection">
                <div class="col-md-6">

                    <label asp-for="Price" class="form-label">
                        Course Price (BDT)
                    </label>

                    <div class="input-group">
                        <span class="input-group-text">BDT</span>

                        <input asp-for="Price"
                               type="number"
                               step="0.01"
                               min="0"
                               class="form-control"
                               id="coursePrice" />
                    </div>

                    <span asp-validation-for="Price"
                          class="text-danger small"></span>
                </div>
            </div>
        </div>

        <div class="course-form-actions">

            <a asp-controller="Course"
               asp-action="Index"
               class="course-btn-cancel">
                Cancel
            </a>

            <button type="submit" class="course-btn-save">
                Update Course
            </button>
        </div>

    </form>
</div>

<partial name="_ValidationScriptsPartial" />

<script>
    document.addEventListener("DOMContentLoaded", function () {

        const freeSwitch =
            document.getElementById("isFreeSwitch");

        const priceSection =
            document.getElementById("priceSection");

        const priceInput =
            document.getElementById("coursePrice");

        function updatePrice() {
            if (freeSwitch.checked) {
                priceSection.style.display = "none";
                priceInput.value = "0";
            } else {
                priceSection.style.display = "";
            }
        }

        freeSwitch.addEventListener("change", updatePrice);

        updatePrice();
    });
</script>
